{
  "name": "xiaoxi-active-touch-desktop",
  "productName": "AI获客 V1.0版本",
  "description": "AI获客 V1.0版本 Windows 微信客户运营助手",
  "version": "1.1.1",
  "componentBaseVersion": "1.1.0",
  "private": true,
  "main": "src/main/bootstrap.cjs",
  "scripts": {
    "prebuild": "npm run check:clean-runtime && npm run check:edition-boundaries && npm run check:deepseek-api",
    "check:clean-runtime": "node scripts/check-clean-runtime.cjs",
    "check:edition-boundaries": "node scripts/customer-edition.self_check.cjs",
    "check:deepseek-api": "node src/main/deepseek-api.self_check.cjs",
    "check:self": "node scripts/run-self-checks.cjs",
    "check:product-detail-e2e": "node scripts/product-detail-local-e2e.cjs --cleanup-on-success",
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/dev-electron.cjs",
    "build": "npm run build:delivery",
    "build:product-detail": "node scripts/build-product-detail-sidecar.cjs",
    "build:content-engine": "node scripts/build-content-engine-sidecar.cjs",
    "build:remotion-runtime": "node scripts/build-remotion-runtime.cjs development",
    "build:remotion-runtime:internal-evaluation": "node scripts/build-remotion-runtime.cjs internal-evaluation",
    "build:remotion-runtime:delivery": "node scripts/build-remotion-runtime.cjs delivery",
    "check:remotion-runtime": "node scripts/portable-runtime-dependencies.self_check.cjs",
    "build:test": "node scripts/build-renderer.cjs test",
    "build:delivery": "node scripts/build-renderer.cjs delivery",
    "build:helper": "node scripts/build-contact-helper.cjs",
    "release:test": "node scripts/run-release.cjs test",
    "release:internal": "node scripts/build-internal-release.cjs",
    "release:components": "node scripts/build-internal-components.cjs",
    "publish:components": "node scripts/publish-component-release.cjs",
    "publish:internal": "node scripts/publish-cloud-release.cjs",
    "release:delivery": "node scripts/run-release.cjs delivery",
    "release:upgrade": "node scripts/run-release.cjs upgrade",
    "release:installer": "npm run check:self && npm run check:product-detail-e2e && npm run check:clean-runtime && node scripts/build-installer-release.cjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@remotion/renderer": "4.0.512",
    "jszip": "3.10.1",
    "mammoth": "^1.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.512"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.512",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.468.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
